# ---------------------------------------------------------------------------
# Beauty Alley backend - environment template.
# Copy to .env and fill in. .env is gitignored; never commit real keys.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- Supabase project ------------------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Settings -> API -> Project API keys.
# SUPABASE_ANON_KEY is public by design (it is shipped to browsers).
SUPABASE_ANON_KEY=

# DANGER: bypasses Row Level Security entirely. Server-side only.
# Never expose this to a client, never log it, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Direct Postgres -------------------------------------------------------
# Used ONLY by scripts/migrate.js and the test harness.
# Format: postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=

# --- Domain rules ----------------------------------------------------------
# Branch local timezone. All timestamps are stored as UTC timestamptz.
BRANCH_TIMEZONE=Asia/Manila

# Fallback only. The owner sets the live value in Settings → Booking rules;
# this is used when that row is missing.
CANCELLATION_WINDOW_HOURS=2

# --- QR check-in -----------------------------------------------------------
# HMAC-SHA256 key for signing QR payloads. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates every outstanding QR pass.
QR_SIGNING_SECRET=

# Fallback only. Settings → Booking rules is the live value.
QR_CHECKIN_WINDOW_MINUTES=60

# Where a scanned pass points, once the token is verified.
QR_CHECKIN_URL=https://beautyalley.app/check-in

# --- Door kiosk ------------------------------------------------------------
# The pepper behind every door PIN. A PIN is looked up by value (the screen
# knows no employee id), so it cannot carry a per-row salt - this key is what
# stops a dump of staff_pins being reversed. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Leave it empty and the PIN endpoints answer 503; everything else still runs.
# Changing it invalidates every PIN already issued - staff must be re-issued.
KIOSK_PIN_PEPPER=

# --- Reminders -------------------------------------------------------------
# Optional. The queue fills without these; the sender leaves rows PENDING
# until a host is configured. Run `npm run reminders` on a schedule.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Beauty Alley <no-reply@beautyalley.app>

# --- HitPay (deposit test checkout) ----------------------------------------
# Leave the key empty for mock mode: the button opens an internal test page.
# With a sandbox/live key the same call creates a real hosted checkout.
HITPAY_API_KEY=
HITPAY_SALT=
HITPAY_MODE=mock
APP_URL=https://beautyalleyibms.vercel.app

# The walk-in door QR. A different sticker from the desk check-in QR: this one
# starts a registration, the other redeems an existing pass. BRANCH_ID is the
# branch that sticker belongs to.
BRANCH_ID=beautyalley-main
QR_ENTER_URL=https://beautyalley.app/welcome

# --- Login throttling ------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Request throttling ----------------------------------------------------
# Requests per minute, per process. The limiter uses an in-memory store, so on
# serverless the effective ceiling is this value multiplied by the number of
# warm instances. It is a blunt instrument, not a quota. Lower it if a single
# client is expected to dominate traffic; a hard global limit needs a shared
# store, not a bigger number here.
RATE_LIMIT_MAX=120

# --- Public exposure -------------------------------------------------------
# Comma-separated browser origins allowed to call the API. Leave empty while
# the API is local-only (development reflects any origin). Set this the moment
# the API is reachable from the internet - on Vercel it is REQUIRED, because
# the API refuses to boot in production with neither this nor SERVE_APP:
#   ALLOWED_ORIGINS=https://beautyalleyibms.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=

# Serve the built frontend (repo-root dist/) from this process too, so one
# origin carries both the app and the API. That is the self-hosted container
# (see the Dockerfile). Leave it false on Vercel, where the frontend is its own
# service. Off by default: `/` is then the JSON endpoint index.
SERVE_APP=false

# --- Destructive operations ------------------------------------------------
# Each of these gates a script that cannot be undone. All of them refuse
# outright under NODE_ENV=production, and none of them is required for normal
# development: leave them unset unless this checkout points at a database whose
# contents do not matter.
#
# `npm run db:seed` TRUNCATEs seventeen tables. Set this to 1 ONLY in a
# .env.local that points at a disposable database. Individual runs can bypass it
# with `npm run db:seed -- --force`.
ALLOW_DESTRUCTIVE_SEED=

# `npm run db:restore` replaces every table in the snapshot. `--yes` alone is
# not enough; add this (or `--force`) once the target is known disposable.
ALLOW_DESTRUCTIVE_RESTORE=

# `node scripts/reset-demo-data.js --apply` DELETEs every booking and every
# client that is not one of the two seeded rows.
ALLOW_DEMO_RESET=

# --- Test database ---------------------------------------------------------
# The integration suite seeds, which TRUNCATEs seventeen tables, so it refuses
# to run against the database the application uses. Point .env.test.local at a
# second Supabase project and name its host here. The suite compares the two and
# refuses on a mismatch - which is how CI catches a swapped TEST_DATABASE_URL.
# Example: TEST_DB_HOST=db.abcdefghijklmnop.supabase.co
TEST_DB_HOST=
